{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrnoobsky-del/a01-eva-sphere/blob/main/schemas/a01-agent-mission-v0.1.schema.json",
  "title": "A-01 Agent Mission Proposal v0.1",
  "type": "object",
  "required": [
    "schema",
    "goal",
    "summary",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": "a01.agent-mission.v0.1"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "id",
        "tool",
        "args",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,32}$"
        },
        "tool": {
          "enum": [
            "read_map",
            "inspect",
            "go_to",
            "walk_route",
            "pose",
            "look",
            "capture_eye_frame",
            "send_frame_to_bridge",
            "stop",
            "look_at"
          ]
        },
        "args": {
          "type": "object"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 500,
          "maximum": 600000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tool": {
                "enum": [
                  "read_map",
                  "inspect",
                  "stop",
                  "capture_eye_frame",
                  "send_frame_to_bridge"
                ]
              }
            },
            "required": [
              "tool"
            ]
          },
          "then": {
            "properties": {
              "args": {
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "go_to"
              }
            },
            "required": [
              "tool"
            ]
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "required": [
                  "destination"
                ],
                "properties": {
                  "destination": {
                    "type": "string",
                    "minLength": 1
                  },
                  "gait": {
                    "enum": [
                      "Walking",
                      "Running"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "walk_route"
              }
            },
            "required": [
              "tool"
            ]
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "required": [
                  "stops"
                ],
                "properties": {
                  "stops": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "gait": {
                    "enum": [
                      "Walking",
                      "Running"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "pose"
              }
            },
            "required": [
              "tool"
            ]
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "enum": [
                      "Idle",
                      "Walking",
                      "Running",
                      "Wave",
                      "Point",
                      "Inspect"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "look"
              }
            },
            "required": [
              "tool"
            ]
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "required": [
                  "yawDegrees",
                  "pitchDegrees"
                ],
                "properties": {
                  "yawDegrees": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "pitchDegrees": {
                    "type": "number",
                    "minimum": -65,
                    "maximum": 65
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "look_at"
              }
            },
            "required": [
              "tool"
            ]
          },
          "then": {
            "properties": {
              "args": {
                "type": "object",
                "required": [
                  "target"
                ],
                "properties": {
                  "target": {
                    "type": "object",
                    "required": [
                      "x",
                      "y",
                      "z"
                    ],
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": -1000,
                        "maximum": 1000
                      },
                      "y": {
                        "type": "number",
                        "minimum": -1000,
                        "maximum": 1000
                      },
                      "z": {
                        "type": "number",
                        "minimum": -1000,
                        "maximum": 1000
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
