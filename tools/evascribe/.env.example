# Whisper defaults are compatible with CPU-only Windows computers.
EVASCRIBE_MODEL=base
EVASCRIBE_DEVICE=cpu
EVASCRIBE_COMPUTE_TYPE=int8
EVASCRIBE_LANGUAGE=auto
EVASCRIBE_MAX_UPLOAD_MB=2048
EVASCRIBE_MAX_MEDIA_SECONDS=14400
EVASCRIBE_ALLOWED_HOSTS=youtube.com,www.youtube.com,m.youtube.com,youtu.be

# Optional OpenAI-compatible endpoint. Example for a locally running Ollama:
# EVASCRIBE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# EVASCRIBE_LLM_MODEL=your-local-model
# EVASCRIBE_LLM_API_KEY=
# EVASCRIBE_LLM_TIMEOUT_SECONDS=90

# Optional custom storage location:
# EVASCRIBE_DATA_DIR=D:\\EvaScribeData
