{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mrnoobsky-del/a01-eva-sphere/releases/a01-x-v0.3.0/riddle.schema.json",
  "title": "A-01 X Engineering Riddle",
  "description": "A traceable question-to-engineering-work item for Sphere Intelligence.",
  "type": "object",
  "required": ["id", "question", "domain", "status", "hypotheses", "verification"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^R-[0-9]{3,}$"
    },
    "question": {
      "type": "string",
      "minLength": 12
    },
    "why_it_matters": {
      "type": "string"
    },
    "domain": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["air", "climate", "light", "acoustics", "water", "movement", "sanitation", "nourishment", "rest_mind", "biophilia", "energy_resilience", "digital_security", "robot_inspection", "human_proxy"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "affected_zones": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "affected_profiles": {
      "type": "array",
      "items": {"type": "string"}
    },
    "known_facts": {
      "type": "array",
      "items": {"type": "string"}
    },
    "unknowns": {
      "type": "array",
      "items": {"type": "string"}
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["statement", "falsification"],
        "properties": {
          "statement": {"type": "string"},
          "falsification": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "requirement": {
      "type": "string"
    },
    "safety_constraints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "verification": {
      "type": "object",
      "required": ["method", "pass_criteria", "fail_criteria"],
      "properties": {
        "method": {"type": "string"},
        "pass_criteria": {"type": "array", "items": {"type": "string"}},
        "fail_criteria": {"type": "array", "items": {"type": "string"}},
        "test_artifacts": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "side_effects": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_level": {
      "type": "string",
      "enum": ["T0", "T1", "T2", "T3", "T4", "T5"]
    },
    "status": {
      "type": "string",
      "enum": ["open", "hypothesis", "test-ready", "verified", "rejected", "blocked"]
    },
    "owner": {
      "type": ["string", "null"]
    },
    "references": {
      "type": "array",
      "items": {"type": "string", "format": "uri"}
    },
    "decision_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "decision"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "decision": {"type": "string"},
          "commit": {"type": ["string", "null"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
